APP_NAME=AI Calling Backend
APP_ENV=development
DEBUG=false

DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ai_calling

JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

SARVAM_API_KEY=
SARVAM_BASE_URL=
SARVAM_WEBHOOK_SECRET=

CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_ENABLED=true
DEFAULT_TIMEZONE=Asia/Kolkata

# Production only (ignored by local dev):
PORT=8000
WEB_CONCURRENCY=4
GUNICORN_TIMEOUT=30
